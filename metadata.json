{
  "product": "scraping",
  "catalogTitle": "Web Scraping MCP by GeoRanker",
  "description": "Public web page content as readable text or HTML for AI agents, powered by GeoRanker.",
  "websiteTitle": "GeoRanker Web Scraping MCP",
  "package": "@georanker/web-scraping-mcp",
  "repository": "https://github.com/georanker/georanker-web-scraping-mcp",
  "tools": [
    "fetch_page",
    "get_fetch_result"
  ],
  "transport": "stdio",
  "hostedPath": "/scraping/mcp",
  "defaultCacheSeconds": 604800,
  "forceLiveParameter": "forceLive",
  "version": "0.14.0",
  "status": "public-client",
  "license": "MIT",
  "distribution": {
    "primary": "npm",
    "packageUrl": "https://www.npmjs.com/package/@georanker/web-scraping-mcp",
    "availabilitySource": "https://registry.npmjs.org/",
    "fallback": "github-source"
  },
  "autoUpdate": {
    "repository": "https://github.com/georanker/georanker-web-scraping-mcp",
    "branch": "main",
    "channel": "github-releases",
    "verification": "sigstore-oidc-provenance",
    "workflow": ".github/workflows/client-release.yml",
    "checkIntervalSeconds": 300,
    "activation": "idle-worker-swap",
    "idleToolSeconds": 60,
    "minimumBootstrapVersion": "0.12.0",
    "minimumSupervisorVersion": "0.13.0",
    "quietChecks": true
  }
}
